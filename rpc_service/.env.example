# --- add-on service (all SH_*) -------------------------------------------
# Copy to rpc_service/.env. Process env wins over this file; the repo root .env
# is only a fallback for the RPC_* names below.
SH_HOST=127.0.0.1
SH_PORT=8080
SH_PUBLIC_BASE_URL=
SH_CORS_ORIGINS=
SH_TRUST_PROXY=0
SH_DB_PATH=rpc_service/data/service.db
SH_LOG_LEVEL=INFO

# second, dashboard-only bot (NOT the existing TELEGRAM_BOT_TOKEN)
SH_TG_DASH_BOT_TOKEN=
SH_TG_WEBAPP_URL=
SH_INITDATA_TTL=3600
SH_SESSION_TTL=2592000

# admin token for sign/broadcast/suspend endpoints
SH_ADMIN_TOKEN=

# --- networks ------------------------------------------------------------
SH_NETWORKS=ethereum,bsc,polygon,base,arbitrum,optimism,avalanche,solana
SH_RPC_ETHEREUM=
SH_RPC_BSC=
SH_RPC_POLYGON=
SH_RPC_BASE=
SH_RPC_ARBITRUM=
SH_RPC_OPTIMISM=
SH_RPC_AVALANCHE=
SH_RPC_SOLANA=
SH_ALCHEMY_KEY=
SH_HELIUS_KEY=
SH_ANKR_KEY=
SH_RPC_TIMEOUT_MS=8000
SH_RPC_MAX_BATCH=20
SH_RPC_RATE_FREE=60
SH_RPC_RATE_PREMIUM=600
SH_RPC_DAILY_FREE=2000
SH_RPC_DAILY_PREMIUM=100000

# --- subscriptions -------------------------------------------------------
SH_PREMIUM_PRICE_USD=20
SH_PRICE_SOURCE=static
SH_PRICE_STATIC_BTC=95000
SH_PRICE_STATIC_ETH=3000
SH_PRICE_STATIC_SOL=150
SH_PRICE_STATIC_BNB=600
SH_INVOICE_TTL=1800
SH_UNDERPAY_TOLERANCE_BPS=50
SH_CONFIRMATIONS_BTC=3
SH_CONFIRMATIONS_ETH=12
SH_CONFIRMATIONS_SOL=32
SH_CONFIRMATIONS_BNB=15
SH_BTC_API=https://mempool.space/api
SH_DEPOSIT_BTC=
SH_DEPOSIT_ETH=
SH_DEPOSIT_SOL=
SH_DEPOSIT_BNB=
SH_MONITOR_ENABLED=0
SH_MONITOR_INTERVAL=60

# --- custody / withdrawals ----------------------------------------------
SH_WITHDRAWALS_ENABLED=0
SH_KMS_REGION=eu-central-1
SH_KMS_KEY_EVM=
SH_KMS_KEY_SOL=
SH_PIN_MAX_FAILS=5
SH_PIN_LOCK_MINUTES=15
SH_WITHDRAW_DAILY_COUNT=5
SH_WITHDRAW_MIN_ETH=0
SH_WITHDRAW_MAX_ETH=1000000000000000000
SH_WITHDRAW_MIN_BNB=0
SH_WITHDRAW_MAX_BNB=10000000000000000000
SH_WITHDRAW_MIN_SOL=0
SH_WITHDRAW_MAX_SOL=10000000000